# Configurações do PDI Angola
# Copie este arquivo para .env e configure as variáveis

# Base de dados
DB_HOST=localhost
DB_NAME=pdi_angola
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Aplicação
APP_NAME=PDI Angola - Gestão de Infraestruturas
APP_VERSION=1.2.0
APP_URL=http://localhost/pdi_angola
ENVIRONMENT=development

# Segurança
JWT_SECRET=pdi_angola_jwt_secret_key_2025_secure_token_auth
PASSWORD_SALT=pdi_angola_password_salt_2025_secure_hash
CSRF_SECRET=pdi_angola_csrf_secret_key_2025_secure_form

# Sessão
SESSION_LIFETIME=3600

# Upload
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf,doc,docx

# Paginação
ITEMS_PER_PAGE=20

# Logs
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Email/SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sistema.pdi.angola@gmail.com
SMTP_PASSWORD=pdi_angola_email_app_password
SMTP_SECURE=tls
SMTP_SENDER_EMAIL=sistema.pdi.angola@gmail.com
SMTP_SENDER_NAME=PDI Angola - Sistema de Gestão
EMAIL_ENABLED=true
EMAIL_NATIVE_FALLBACK=true
SMTP_DEBUG=false

# Cache
CACHE_ENABLED=true
CACHE_DRIVER=file
CACHE_TTL=3600

# Rate Limiting
#RATE_LIMIT_ENABLED=true
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Backup
BACKUP_ENABLED=true
BACKUP_PATH=backups/
BACKUP_RETENTION_DAYS=30
